{
  "name": "vektor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run db:migrate:local && vp dev --host 127.0.0.1",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "prepare": "vp config",
    "postinstall": "wrangler types",
    "preflight": "node scripts/ensure-dev-vars.mjs",
    "reset:d1": "node scripts/reset-local-d1.mjs",
    "seed:admin": "node scripts/seed-admin.ts",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "clean": "rm -rf .output .nitro .vinxi .tanstack .wrangler .vite .vitest coverage dist dist-ssr node_modules/.vite playwright-report playwright/.cache blob-report test-results",
    "test:smoke": "vp run preflight && vp run reset:d1 && vp build && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "1.168.46",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.11.2"
}
